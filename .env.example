# Dev mode - set to true for frontend-only development (no Convex needed)
NEXT_PUBLIC_DEV_MODE=true

# Convex - only needed for full-stack development
# Create your own project at https://convex.dev and run: npx convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# OAuth - only needed if working on login flow
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cohere - only needed if working on embeddings
COHERE_API_KEY=

# Dodo Payments - only needed if working on billing
NEXT_PUBLIC_DODO_PRO_PRODUCT_ID=
NEXT_PUBLIC_DODO_PRO_PLUS_PRODUCT_ID=
DODO_PAYMENTS_API_KEY=
